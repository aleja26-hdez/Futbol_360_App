    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.futbol360.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
